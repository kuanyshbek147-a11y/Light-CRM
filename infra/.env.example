# Copy to infra/.env (npm run setup:env does this).
# Docker Compose overrides DB_HOST=db via service environment.

PORT=4000
JWT_SECRET=dev-secret

# Local (without Docker): use localhost. Docker path overrides to "db".
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_crm

# Optional: disable inbound message simulator (0 = off)
SIMULATOR_INTERVAL_MS=0

# Frontend (also see frontend/.env.example)
VITE_API_URL=http://localhost:4000/api

# --- Integrations (optional for local CRM UI) ---
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_ID=
WHATSAPP_VERIFY_TOKEN=lightcrm-meta-verify-2026
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
PUBLIC_BASE_URL=

CHATAPP_API_BASE_URL=https://api.chatapp.online
CHATAPP_API_TOKEN=
CHATAPP_EMAIL=
CHATAPP_PASSWORD=
CHATAPP_APP_ID=
CHATAPP_SEND_MESSAGE_PATH=/v1/messages
CHATAPP_CHANNEL_ID=
CHATAPP_WEBHOOK_SECRET=
CHATAPP_WEBHOOK_SECRET_HEADER=x-chatapp-secret

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=telegram-dev-secret
TELEGRAM_DELIVERY_MODE=webhook

# Instagram Login app — do not confuse with WHATSAPP_APP_ID
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=
INSTAGRAM_PAGE_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_API_VERSION=v21.0

META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_PAGE_ID=
META_ADS_API_VERSION=v21.0
ADS_DEFAULT_LINK_URL=

AUTO_ASSIGNMENT_STRATEGY=round_robin
SUPER_ADMIN_LOGIN=superadmin
SUPER_ADMIN_EMAIL=platform@lightcrm.local
SUPER_ADMIN_PASSWORD=superadmin123

# AES-256 key for email app passwords at-rest (64 hex chars). Local/dev placeholder only.
# Generate your own for any shared/staging/prod: openssl rand -hex 32
EMAIL_CREDENTIALS_KEY=a9bb135d09f079e20412da0706048cc7a89595f2a7f4a3ca2456c65b75f8f96b

# Optional: AI auto-reply
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
