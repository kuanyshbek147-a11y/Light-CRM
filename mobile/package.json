    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.2",
    "@mozartec/capacitor-microphone": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  }
}
